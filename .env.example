# Copy this file to .env and set a real value before running the server.
# Never commit the real .env file -- it's listed in .gitignore.

# Shared-secret access token that every tool call must present.
# Generate one yourself, e.g.: python -c "import secrets; print(secrets.token_hex(16))"
APP_API_KEY=changeme-generate-your-own-random-token
